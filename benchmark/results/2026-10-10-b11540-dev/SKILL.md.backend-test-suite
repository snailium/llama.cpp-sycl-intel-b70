### Step 3: T1/T2 (direct, streaming)

```bash
# JSON is built programmatically so the prompt is never re-quoted - re-quoting is one of
# the ways prompt text silently changes.
python3 - "$T1" > t1_request.json <<'PY'
import json, sys
print(json.dumps({
    "model": "<MODEL_ID>",
    "messages": [{"role": "user", "content": sys.argv[1]}],
    "max_tokens": 32768,
    "stream": True,
    "chat_template_kwargs": {"enable_thinking": False},
}))
PY
curl -sN http://<HOST>:<PORT>/v1/chat/completions \
  -H "Content-Type: application/json" --data-binary @t1_request.json > t1_raw.jsonl
# T2 is the same call with "$T2".
```

Grading is mechanical — never from the model's description of what it produced:

```bash
python3 - <<'PY'
import json, re
from html.parser import HTMLParser
import xml.etree.ElementTree as ET

def strip_fence(c):
    m = re.match(r"\s*```[a-zA-Z0-9]*\s*\n(.*?)\n?\s*```\s*$", c, re.S)
    return (m.group(1) if m else c).strip()

for name, kind in (("t1", "html"), ("t2", "xml")):
    d = json.load(open(f"{name}_result.json"))
    ch = d["choices"][0]
    doc = strip_fence(ch["message"].get("content") or "")
    checks = {"finish_reason == stop": ch.get("finish_reason") == "stop"}
    if kind == "html":
        stack, bad = [], []
        class P(HTMLParser):
            VOID = {"area","base","br","col","embed","hr","img","input","link","meta","source","track","wbr"}
            def handle_starttag(self, t, a):
                if t not in self.VOID: stack.append(t)
            def handle_endtag(self, t):
                if stack and stack[-1] == t: stack.pop()
                else: bad.append(t)
        P().feed(doc)
        checks |= {"parses / balanced": not bad and not stack,
                   "html/head/body": all(f"<{t}" in doc for t in ("html","head","body")),
                   "ends at </html>": doc.endswith("</html>")}
    else:
        try:
            root = ET.fromstring(doc)
            checks |= {"well-formed XML": True,
                       "single <svg> root": root.tag.split("}")[-1] == "svg",
                       "has viewBox": "viewBox" in root.attrib,
                       "ends at </svg>": doc.endswith("</svg>")}
        except ET.ParseError as e:
            checks |= {"well-formed XML": False}
            print(f"  {name}: XML parse error: {e}")
    print(f"  {name}: {'PASS' if all(checks.values()) else 'FAIL'}")
    for k, v in checks.items():
        print(f"    {'OK  ' if v else 'FAIL'} {k}")
PY
```

