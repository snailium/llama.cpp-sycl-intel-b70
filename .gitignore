# Build artifacts
build/
*.so
*.so.*
# The llama / llama-* entries are the BUILT BINARIES at the repo root. Anchor them
# with a leading slash: an unanchored `llama-*` also matches by basename anywhere,
# which silently hid five upstream source files under llama.cpp/src/
# (llama-version.h.in and four llama-*.cpp/.h). llama-version.h.in is a CMake
# configure_file INPUT, so hiding it breaks the build at the configure step with
#   CMake Error: File /app/llama.cpp/src/llama-version.h.in does not exist.
/llama
/llama-*

# Docker
*.tar

# IDE / OS
.DS_Store
.idea/
.vscode/
*.swp

# Models (never commit downloaded weights)
# Anchored to the repo root: this is our own ./models/ download directory. An
# unanchored `models/` also matches by basename at any depth, which silently
# dropped 17 upstream source files from the subtree sync — src/models/*.cpp
# (model implementations, pulled in by a GLOB so the build does not even warn),
# tools/mtmd/models/*.cpp (an EXPLICIT source list, which fails configure with
#   CMake Error: Cannot find source file: models/deepseek4v.cpp), and
# models/templates/*.jinja (chat templates).
/models/
*.gguf
*.bin

# Logs
*.log

# local docker CLI state (harness/promote) — never commit
.docker-home/
